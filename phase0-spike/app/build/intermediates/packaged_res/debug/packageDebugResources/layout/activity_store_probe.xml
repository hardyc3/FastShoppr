<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/probeUrl" android:textSize="12sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnExtract" android:text="Extract" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <WebView android:id="@+id/webView" android:layout_weight="3" android:layout_width="match_parent" android:layout_height="0dp"/>
    <ScrollView android:layout_weight="2" android:layout_width="match_parent" android:layout_height="0dp">
        <TextView android:id="@+id/extractResult" android:textSize="11sp" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
